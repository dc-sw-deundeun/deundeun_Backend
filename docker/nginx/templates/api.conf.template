# ${NGINX_SERVER_NAME} -> FastAPI (compose service: ${NGINX_UPSTREAM_HOST})
# HTTPS: add cert volume and 443 server block when TLS is introduced.

upstream deundeun_api {
    server ${NGINX_UPSTREAM_HOST}:${NGINX_UPSTREAM_PORT};
    keepalive ${NGINX_UPSTREAM_KEEPALIVE};
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location / {
        proxy_pass http://deundeun_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }
}
