# =============================================================================
# deundeun Backend — 환경 변수 템플릿
# 복사: cp .env.example .env  (로컬)  |  서버: /opt/deundeun/.env 직접 작성
# =============================================================================

APP_ENV=development

# -----------------------------------------------------------------------------
# Docker Compose (로컬 /opt/deundeun 공통)
# compose 파일: docker/docker-compose.yml  |  서버: /opt/deundeun/docker-compose.yml
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=deundeun

# API 컨테이너 (profile: deploy)
IMAGE_TAG=deundeun/backend:latest
APP_ENV_FILE=../.env
API_SERVICE=api
API_CONTAINER_NAME=deundeun-api
API_CONTAINER_PORT=8000
# 호스트 바인딩 — nginx 뒤에서는 127.0.0.1 권장 (외부 노출은 nginx :80)
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8000
API_RESTART_POLICY=unless-stopped
API_HEALTHCHECK_INTERVAL=30s
API_HEALTHCHECK_TIMEOUT=10s
API_HEALTHCHECK_RETRIES=3
API_HEALTHCHECK_START_PERIOD=10s

# PostgreSQL (compose service: postgres)
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=deundeun-postgres
POSTGRES_RESTART_POLICY=unless-stopped
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=deundeun
POSTGRES_PASSWORD=deundeun
POSTGRES_DB=deundeun
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=5
POSTGRES_HEALTHCHECK_START_PERIOD=10s

# Nginx (compose service: nginx, profile: deploy)
NGINX_IMAGE=nginx:1.27-alpine
NGINX_CONTAINER_NAME=deundeun-nginx
NGINX_RESTART_POLICY=unless-stopped
NGINX_HTTP_PORT=80
# compose 파일 기준 상대 경로 (서버: /opt/deundeun/nginx)
NGINX_CONF_DIR=./nginx
NGINX_SERVICE=nginx
START_NGINX=true
NGINX_SERVER_NAME=api.deundeun.xyz
NGINX_UPSTREAM_HOST=api
NGINX_UPSTREAM_PORT=8000
NGINX_UPSTREAM_KEEPALIVE=16
NGINX_CLIENT_MAX_BODY_SIZE=32m
NGINX_PROXY_CONNECT_TIMEOUT=60s
NGINX_PROXY_READ_TIMEOUT=120s
NGINX_HEALTHCHECK_INTERVAL=30s
NGINX_HEALTHCHECK_TIMEOUT=5s
NGINX_HEALTHCHECK_RETRIES=3
NGINX_HEALTHCHECK_START_PERIOD=10s

# CD / deploy.sh
RUN_MIGRATIONS=true
HEALTHCHECK_TIMEOUT_SECONDS=60
HEALTHCHECK_INTERVAL_SECONDS=2

# -----------------------------------------------------------------------------
# Application — DB
# 로컬 (호스트 → compose postgres): localhost + POSTGRES_PORT
# 서버 (api 컨테이너 → compose postgres): 호스트명 postgres, 포트 5432
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://deundeun:deundeun@localhost:55432/deundeun

# -----------------------------------------------------------------------------
# JWT
# staging/production: change-me 사용 불가 (앱 기동 시 검증)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# SMTP (Gmail 등)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# 외부 의학 KG(#9) Neo4j 컨테이너 인증용 — docker-compose neo4j 서비스만 사용.
# (PKG(#23)는 앱 Postgres(pkg_snapshots)에 영속되어 앱은 Neo4j에 접속하지 않는다)
NEO4J_PASSWORD=change-me

# External Analysis Server (Phase 4)
ANALYSIS_CLIENT=stub
ANALYSIS_SERVER_BASE_URL=
ANALYSIS_SERVER_API_KEY=
ANALYSIS_CALLBACK_SECRET=dev-analysis-callback-secret
ANALYSIS_POLLING_INTERVAL_SECONDS=60

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20

# Health Metric Rate Limit
HEALTH_METRIC_EVALUATE_RATE_LIMIT_PER_MINUTE=20
HEALTH_METRIC_ANALYSIS_RATE_LIMIT_PER_MINUTE=10

# CORS — 브라우저 프론트엔드 origin을 JSON 배열로 명시
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type"]

# Reverse Proxy (nginx compose 뒤 배포 시 true)
TRUSTED_PROXY=false
# JSON 배열 (Docker bridge: 172.16.0.0/12)
TRUSTED_PROXY_CIDRS=["172.16.0.0/12","10.0.0.0/8","127.0.0.1/32"]

# Clova OCR (staging/production 필수)
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
OCR_MIN_CONFIDENCE=0.8
OCR_REQUEST_TIMEOUT_SECONDS=15
OCR_MAX_RETRIES=1
MAX_IMAGES_PER_UPLOAD=10
MAX_SINGLE_UPLOAD_SIZE_BYTES=10485760
MAX_TOTAL_UPLOAD_SIZE_BYTES=31457280
OCR_CONCURRENCY=5
OCR_GLOBAL_CONCURRENCY=10
OCR_ACQUIRE_TIMEOUT_SECONDS=1.0
OCR_RETRY_AFTER_SECONDS=10

# =============================================================================
# 서버 스테이징 (/opt/deundeun/.env) — 아래처럼 덮어쓰기
# =============================================================================
# APP_ENV=staging
# APP_ENV_FILE=/opt/deundeun/.env
# IMAGE_TAG=deundeun/backend:develop
# NGINX_CONF_DIR=/opt/deundeun/nginx
# NGINX_HTTP_PORT=80
# NGINX_SERVER_NAME=api.deundeun.xyz
# NGINX_UPSTREAM_HOST=api
# NGINX_UPSTREAM_PORT=8000
# POSTGRES_BIND=127.0.0.1
# POSTGRES_PORT=5432
# API_HOST_BIND=127.0.0.1
# API_HOST_PORT=8000
# DATABASE_URL=postgresql+psycopg2://deundeun:<POSTGRES_PASSWORD>@postgres:5432/deundeun
# JWT_SECRET_KEY=<openssl rand -hex 32>
# CORS_ALLOW_ORIGINS=["https://<frontend-domain>"]
# TRUSTED_PROXY=true
# TRUSTED_PROXY_CIDRS=["172.16.0.0/12","10.0.0.0/8"]
# CLOVA_OCR_INVOKE_URL=...
# CLOVA_OCR_SECRET_KEY=...
