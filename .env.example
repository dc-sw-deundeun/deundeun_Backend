APP_ENV=development

# PostgreSQL (로컬 Compose: docker/docker-compose.yml, 기본 포트 55432)
DATABASE_URL=postgresql+psycopg2://deundeun:deundeun@localhost:55432/deundeun
POSTGRES_PORT=55432

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP (Gmail 등)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# External Analysis Server (Phase 3)
ANALYSIS_SERVER_BASE_URL=
ANALYSIS_SERVER_API_KEY=
ANALYSIS_CALLBACK_SECRET=
ANALYSIS_POLLING_INTERVAL_SECONDS=60

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=

# Health Metric Rate Limit
HEALTH_METRIC_EVALUATE_RATE_LIMIT_PER_MINUTE=20
HEALTH_METRIC_ANALYSIS_RATE_LIMIT_PER_MINUTE=10

