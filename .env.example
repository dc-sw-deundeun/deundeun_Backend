APP_ENV=development

# PostgreSQL (로컬 Compose: docker/docker-compose.yml, 기본 포트 55432)
DATABASE_URL=postgresql+psycopg2://deundeun:deundeun@localhost:55432/deundeun
POSTGRES_PORT=55432

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP (Gmail 등)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# External Analysis Server (Phase 3)
ANALYSIS_SERVER_BASE_URL=
ANALYSIS_SERVER_API_KEY=
ANALYSIS_CALLBACK_SECRET=
ANALYSIS_POLLING_INTERVAL_SECONDS=60

# Clova OCR (Phase 3)
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
OCR_POLLING_INTERVAL_SECONDS=30
OCR_MIN_CONFIDENCE=0.8
OCR_REQUEST_TIMEOUT_SECONDS=30
OCR_MAX_RETRIES=2
OCR_STUCK_TIMEOUT_SECONDS=300
LOCAL_STORAGE_DIR=var/ocr_tmp

