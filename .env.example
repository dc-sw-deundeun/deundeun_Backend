APP_ENV=development

# DB 확정 후 기입 (예: postgresql+psycopg2://user:pass@localhost:5432/deundeun)
DATABASE_URL=
POSTGRES_PORT=55432

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP (Gmail 등)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# External Analysis Server (Phase 3)
ANALYSIS_SERVER_BASE_URL=
ANALYSIS_SERVER_API_KEY=
ANALYSIS_CALLBACK_SECRET=
ANALYSIS_POLLING_INTERVAL_SECONDS=60

