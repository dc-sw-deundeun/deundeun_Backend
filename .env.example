APP_ENV=development

# DB 확정 후 기입 (예: postgresql+psycopg2://user:pass@localhost:5432/deundeun)
DATABASE_URL=
POSTGRES_PORT=55432

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP (Gmail 등)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# External Analysis Server (Phase 3)
ANALYSIS_SERVER_BASE_URL=
ANALYSIS_SERVER_API_KEY=
ANALYSIS_CALLBACK_SECRET=
ANALYSIS_POLLING_INTERVAL_SECONDS=60

# 외부 의학 KG / Neo4j (이슈 #9 — ETL 스크립트 & docker compose에서 사용)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# 식약처 DUR API (공공데이터포털 - 의약품 DUR정보, 이슈 #9 Phase4)
DUR_API_KEY=
DUR_BASE_URL=http://apis.data.go.kr/1471000/DURPrdlstInfoService03

